{
  "name": "tanstack-cloudflare-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy": "bun run build && wrangler deploy && wrangler d1 migrations apply starter_db --remote",
    "preview": "bun run build && vite preview",
    "cf-typegen": "wrangler types",
    "wrangler:dev": "wrangler dev --remote",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply starter_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply starter_db --remote",
    "db:studio": "bun drizzle-kit studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/lib/auth.ts",
    "biome:fix": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@phosphor-icons/react": "^2.1.10",
    "@scalar/hono-api-reference": "^0.12.6",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-devtools": "^0.10.8",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.9",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@cloudflare/workers-types": "^4.20260628.1",
    "@tanstack/devtools-vite": "^0.8.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "web-vitals": "^5.3.0",
    "wrangler": "^4.105.0"
  }
}
