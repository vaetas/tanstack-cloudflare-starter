# Public base URL used by better-auth (magic link URLs, callbacks)
# Use the port you actually open in the browser:
# - http://localhost:3000 for `bun run dev`
# - http://localhost:8787 for Cloudflare worker preview
APP_URL="http://localhost:3000"

# Sender address for auth emails (must be onboarded in Cloudflare Email Service)
EMAIL_FROM="mail@your-domain.example"

# Better Auth secret (generate one: `npx @better-auth/cli secret`)
BETTER_AUTH_SECRET=

# Local tooling only (drizzle-kit, wrangler CLI) — not required on the Worker
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_NAME=starter_db
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
